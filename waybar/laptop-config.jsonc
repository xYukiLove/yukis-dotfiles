{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 1,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "padding-left": 0,
  "padding-right": 0,

  "modules-left": [
    //"custom/sep",
    "ext/workspaces",
    "custom/sep",
    "cava",
    "custom/sep"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "custom/sep",
    "mpris",
    "custom/sep",
    //"tray",
    //"custom/sep",
    "network",
    "custom/sep",
    "battery",
    "custom/sep",
    "wireplumber",
    "custom/sep",
    "clock",
    "custom/sep"
  ],
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true,
    "all-outputs": false,
    "persistent-workspaces": {
      "*": 5 
    }
  },
  "mango/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "Ⅰ",
      "2": "Ⅱ",
      "3": "Ⅲ",
      "4": "Ⅳ",
      "5": "Ⅴ"
    },
    "on-click": "activate",
    "hide-empty": "false"
  },
  "mango/window": {
    "format": "{title}",
    "max-length": 50
  },
  "dwl/tags": {
    "num-tags": 9,
    "tag-labels": [
      "1",
      "2",
      "3",
      "4",
      "5"
    ]
  },
  "cava": {
    "cava_config": "/home/Luna/.config/cava/waybar_raw.conf",
    "input_delay": 1.5,
    "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
    "actions": {
      "on-click-right": "mode"
    }
  },
  "mpris": {
    "format": "  {artist} - {title} ",
    "format-paused": " 󰐊 {artist} - {title} ",
    "max-length": 37,
    "tooltip": true,
    "player": "spotify"
  },
  "network": {
    "format-wifi": " {essid} ",
    "format-ethernet": "ANGEL",
    "format-disconnected": "N/A",
    "tooltip": true,
    "on-click": "kitty -e nmtui"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "NOBLOO",
    "format-connected": "BLOO",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10 //6
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 85,
    "format": " CPU {temperatureC}C "
  },
  "temperature#gpu": {
    "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
    "format": " GPU {temperatureC}C "
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": " VOL {volume}% ",
    "format-muted": " VOL MUTED ",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },
  "custom/sep": {
    "format": "|",
    "interval": 0
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%m-%d-%y}",
    "tooltip-format": "{:%A, %B %d, %Y}",
    "on-click": "toggle"
  },
  "battery": {
    "bat": "BAT0",
    "interval": 60,
    "format": " BAT {capacity}% ",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    }
  }
}
